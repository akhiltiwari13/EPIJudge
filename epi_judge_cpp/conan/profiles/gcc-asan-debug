# AddressSanitizer + UndefinedBehaviorSanitizer on top of the gcc debug build.
#
# The `&:` prefix scopes these flags to THIS package only. Without it the flags
# would also apply to every dependency build, changing their package IDs and
# forcing a full from-source rebuild of the graph under sanitizers.

include(gcc-debug)

[conf]
user.epi:variant=asan
&:tools.build:cxxflags=["-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-fno-omit-frame-pointer", "-g3"]
&:tools.build:exelinkflags=["-fsanitize=address,undefined"]
